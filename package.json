    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "check:full": "pnpm run check && pnpm run build"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.11.2"
